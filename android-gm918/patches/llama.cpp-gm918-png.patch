diff --git a/ggml/src/gguf.cpp b/ggml/src/gguf.cpp
index c80b682..7c65302 100644
--- a/ggml/src/gguf.cpp
+++ b/ggml/src/gguf.cpp
@@ -1022,6 +1022,121 @@ struct gguf_context * gguf_init_from_file(const char * fname, struct gguf_init_p
         return nullptr;
     }
 
+    // GM918 Sigil Image VM v4: validate the image metadata before exposing its
+    // page-aligned model stream. The large gmDT CRC/full SHA is intentionally
+    // handled by the provisioning verifier so startup remains demand-paged.
+    unsigned char png_sig[8] = {};
+    if (fread(png_sig, 1, sizeof(png_sig), file) == sizeof(png_sig) &&
+            memcmp(png_sig, "\x89PNG\r\n\x1a\n", 8) == 0) {
+        auto be32 = [](const unsigned char * p) -> uint32_t {
+            return (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) |
+                   (uint32_t(p[2]) << 8) | uint32_t(p[3]);
+        };
+        auto be64 = [&](const unsigned char * p) -> uint64_t {
+            return (uint64_t(be32(p)) << 32) | be32(p + 4);
+        };
+        auto crc32_png = [](uint32_t crc, const unsigned char * data, size_t n) {
+            crc = ~crc;
+            while (n--) {
+                crc ^= *data++;
+                for (int bit = 0; bit < 8; ++bit) {
+                    crc = (crc >> 1) ^ (0xedb88320U & uint32_t(-int32_t(crc & 1)));
+                }
+            }
+            return ~crc;
+        };
+
+        bool have_ihdr = false, have_header = false, have_sprites = false, found = false;
+        uint64_t model_size = 0, sprite_count = 0;
+        uint32_t sprite_bytes = 0, last_sprite_bytes = 0;
+        std::string error;
+        while (error.empty() && !found) {
+            unsigned char head[8];
+            if (fread(head, 1, sizeof(head), file) != sizeof(head)) {
+                error = "truncated PNG chunk header";
+                break;
+            }
+            const uint32_t len = be32(head);
+            if (memcmp(head + 4, "gmDT", 4) == 0) {
+                if (!have_ihdr || !have_header || !have_sprites) {
+                    error = "gmDT precedes required IHDR/gmHD/gmSI";
+                    break;
+                }
+                if (len != model_size) {
+                    error = "gmDT length disagrees with gmHD";
+                    break;
+                }
+                const uint64_t expected_count = (model_size + sprite_bytes - 1) / sprite_bytes;
+                const uint32_t expected_last = uint32_t(model_size - (expected_count - 1) * sprite_bytes);
+                if (sprite_count != expected_count || last_sprite_bytes != expected_last) {
+                    error = "gmSI sprite index disagrees with payload";
+                    break;
+                }
+                if ((uint64_t(gguf_ftell(file)) & 4095U) != 0) {
+                    error = "gmDT payload is not 4 KiB aligned";
+                    break;
+                }
+                found = true;
+                break;
+            }
+
+            // Metadata before gmDT is deliberately bounded. This prevents a
+            // corrupt length from causing excessive allocation or seeking.
+            if (len > 1024 * 1024) {
+                error = "oversized pre-model PNG chunk";
+                break;
+            }
+            std::vector<unsigned char> data(len);
+            unsigned char recorded_crc_bytes[4];
+            if ((len && fread(data.data(), 1, len, file) != len) ||
+                    fread(recorded_crc_bytes, 1, 4, file) != 4) {
+                error = "truncated PNG metadata chunk";
+                break;
+            }
+            uint32_t crc = crc32_png(0, head + 4, 4);
+            crc = crc32_png(crc, data.data(), data.size());
+            if (crc != be32(recorded_crc_bytes)) {
+                error = "PNG metadata CRC mismatch";
+                break;
+            }
+            if (memcmp(head + 4, "IHDR", 4) == 0) {
+                if (have_ihdr || len != 13) error = "invalid or duplicate IHDR";
+                else have_ihdr = true;
+            } else if (memcmp(head + 4, "gmHD", 4) == 0) {
+                if (have_header || len != 18 || memcmp(data.data(), "GM918MMAP4", 10) != 0) {
+                    error = "invalid or duplicate gmHD";
+                } else {
+                    model_size = be64(data.data() + 10);
+                    have_header = model_size > 0 && model_size < 0x80000000ULL;
+                    if (!have_header) error = "invalid gmHD model size";
+                }
+            } else if (memcmp(head + 4, "gmSI", 4) == 0) {
+                if (have_sprites || len != 36 || memcmp(data.data(), "GM918SPRITE1", 12) != 0) {
+                    error = "invalid or duplicate gmSI";
+                } else {
+                    const uint32_t width = be32(data.data() + 12);
+                    const uint32_t height = be32(data.data() + 16);
+                    sprite_bytes = be32(data.data() + 20);
+                    last_sprite_bytes = be32(data.data() + 24);
+                    sprite_count = be64(data.data() + 28);
+                    have_sprites = width == 64 && height == 64 && sprite_bytes == 4096 &&
+                                   last_sprite_bytes > 0 && last_sprite_bytes <= sprite_bytes && sprite_count > 0;
+                    if (!have_sprites) error = "unsupported gmSI sprite geometry";
+                }
+            } else if (memcmp(head + 4, "IEND", 4) == 0) {
+                error = "IEND before gmDT";
+            }
+        }
+        if (!found || !error.empty()) {
+            fclose(file);
+            GGML_LOG_ERROR("%s: invalid GM918 PNG '%s': %s\n", __func__, fname,
+                    error.empty() ? "missing gmDT" : error.c_str());
+            return nullptr;
+        }
+    } else {
+        gguf_fseek(file, 0, SEEK_SET);
+    }
+
     struct gguf_context * result = gguf_init_from_file_ptr(file, params);
     fclose(file);
     return result;
